{
  "name": "gdn_ktn_bund",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "split": "node scripts/processData.js",
    "build-data": "node scripts/buildAvailableData.js",
    "convert-xml": "node scripts/convertXmlToCsv.js",
    "fetch-data": "bash data/fetch-data.sh",
    "fetch-stats": "run-s fetch-stats:*",
    "fetch-stats:statpop": "node scripts/convertPxToStats.js",
    "fetch-stats:statent": "node scripts/convertStatent.js",
    "fetch-stats:roads": "node scripts/convertRoads.js",
    "build-rest": "node scripts/buildRestOfCantons.js",
    "update-data": "run-s fetch-data split fetch-stats build-rest build-data",
    "dev": "vite",
    "build": "run-s build-data type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "tests": "run-p test:unit test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e:html": "playwright test --reporter=html",
    "test:e2e": "playwright test --reporter=line",
    "test": "run-s test:coverage test:e2e",
    "test:coverage": "vitest run --coverage",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write src/",
    "pre-commit": "run-s lint format test:unit build test:e2e",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@primeuix/themes": "^1.2.5",
    "@tailwindcss/vite": "^4.3.5",
    "chart.js": "4.5.0",
    "papaparse": "^5.7.0",
    "pinia": "^3.0.4",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tailwindcss-primeui": "^0.6.1",
    "vue": "^3.5.17",
    "vue-i18n": "^11.1.10",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.9.6",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@playwright/test": "^1.54.1",
    "@primevue/auto-import-resolver": "^4.5.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@tsconfig/node22": "^22.0.6",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/eslint-plugin": "^1.3.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.7.0",
    "@xmldom/xmldom": "^0.9.8",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-plugin-oxlint": "^1.92.0",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-vue": "~10.3.0",
    "jiti": "^2.7.0",
    "jsdom": "^26.0.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "^1.92.0",
    "prettier": "3.6.2",
    "sass-embedded": "^1.108.1",
    "typescript": "~5.8.0",
    "unplugin-vue-components": "^28.8.0",
    "vite": "^7.3.7",
    "vite-plugin-vue-devtools": "^7.7.10",
    "vitest": "^3.1.1",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.158.0"
  }
}
